snippet fetchfn "Supabase fetch function" b
export async function fetch${1:Things}(): Promise<${2:$1}[]> {
  const supabase = getSupabaseClient();

  const { data } = await supabase
    .from("${3:things}")
    .select(${4:"*"})
    .throwOnError();

